FROM ubuntu:26.04@sha256:6a06111c3b0a8600feadb270aec771dc239bf407b25625f93f44ab00e11f4d3c

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        libssl-dev \
        ninja-build \
        openssl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Self-contained toolchain image: no build-context files are copied inside.
# Mount the checkout read-only at runtime; outputs stay inside the container.
CMD ["sh", "-c", "cmake -S /workspace -B /build -G Ninja -DCMAKE_BUILD_TYPE=Debug -DBUILD_TESTING=ON -DOPS_WARNINGS_AS_ERRORS=ON && cmake --build /build --parallel && ctest --test-dir /build --output-on-failure"]
