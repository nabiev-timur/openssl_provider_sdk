@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(OpenSSL 3.0 COMPONENTS Crypto)
include("${CMAKE_CURRENT_LIST_DIR}/openssl_provider_sdkTargets.cmake")
if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    target_link_options(openssl_provider_sdk_registry INTERFACE
        "LINKER:-T,${CMAKE_CURRENT_LIST_DIR}/ops_digest_sections.ld")
    set_property(TARGET openssl_provider_sdk_registry APPEND PROPERTY
        INTERFACE_LINK_DEPENDS "${CMAKE_CURRENT_LIST_DIR}/ops_digest_sections.ld")
endif()
check_required_components(openssl_provider_sdk)
